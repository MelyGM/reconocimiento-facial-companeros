#!/bin/bash
#SBATCH --account=curso04
#SBATCH --job-name=face
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=slurm-%j.out

# ROCm para la GPU AMD
module load rocm/6.4.3
export LD_LIBRARY_PATH=/apps/rocm/rocm-6.4.3/lib:/apps/rocm/rocm-6.4.3/lib64:$LD_LIBRARY_PATH

# Ambiente de Python con TensorFlow
eval "$(conda shell.bash hook)"
conda activate face
export PYTHONNOUSERSITE=1

# Carpeta del proyecto (script, facenet_recuperado.keras y las fotos)
cd ~/reconocimiento_facial

rocm-smi

# Sin XLA ni fusión de ROCm
export TF_XLA_FLAGS="--tf_xla_auto_jit=0"
export TF_DISABLE_XLA=1
export TF_ROCM_FUSION_ENABLE=0

# Revisar la sintaxis y ejecutar
python -m py_compile reconocimiento_facial_companeros.py || exit 1
python -u reconocimiento_facial_companeros.py
